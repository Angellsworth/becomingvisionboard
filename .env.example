# Supabase configuration
# Get these from your Supabase project: Dashboard → Settings → API
# Copy this file to `.env.local` and fill in your values.

NEXT_PUBLIC_SUPABASE_URL=

# Use whichever name Supabase shows you — the app accepts either.
# New projects: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (starts with `sb_publishable_`)
# Legacy projects: NEXT_PUBLIC_SUPABASE_ANON_KEY (long JWT starting with `eyJ`)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: where Supabase redirects users after email confirmation.
# Defaults to ${window.location.origin}/auth/callback?next=/home if unset.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback?next=/home
